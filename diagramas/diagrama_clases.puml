@startuml Diagrama de Clases - Arquitectura POO
!theme vibrant
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

' ============================================================
' PAQUETES
' ============================================================

package "core.token" {
  abstract class TokenBase {
    + valor : str
    + linea : int
    + columna : int
    + get_posicion() : str
  }
  class Token {
    + tipo : str
    + to_dict() : dict
  }
}

package "core.analizadores.base" <<ABSTRACCION>> {
  abstract class AnalizadorLexicoBase {
    # codigo : str
    + {abstract} analizar() : list[Token]
  }
  abstract class ParserBase {
    # tokens : list[Token]
    + {abstract} analizar() : list|dict
  }
  class AnalizadorLenguaje {
    + nombre : str
    + slug : str
    + lexer_cls : type
    + parser_cls : type
    + metadata : dict
    + analizar(codigo) : dict
  }
}

package "core.analizadores.base_clike" <<HERENCIA>> {
  abstract class CLikeLexerBase {
    # pos : int
    # linea : int
    # columna : int
    # tokens : list[Token]
    + PALABRAS_RESERVADAS : set
    + TOKEN_REGEX : list
    + analizar() : list[Token]
    - _manejar_espacios(texto)
    - _crear_token(tipo, texto)
  }
  abstract class CLikeParserBase {
    # pos : int
    # errores : list
    + actual() : Token
    + avanzar()
    + consumir(tipo, msg) : Token
    + analizar() : list|dict
    + {abstract} sentencia() : dict
    + sentencia_if() : dict
    + sentencia_while() : dict
    + sentencia_for() : dict
    + sentencia_return() : dict
    + funcion() : dict
    + declaracion() : dict
    + expresion() : dict
    - _primaria() : dict
    - _expresion_binaria(min) : dict
  }
}

package "core.analizadores (lexers + parsers)" <<POLIMORFISMO>> {
  class CLexer
  class CParser {
    + sentencia() : dict
  }
  class CppLexer
  class CppParser {
    + sentencia() : dict
    - _clase() : dict
    - _miembro() : dict
    - _declaracion_using() : dict
    - _primaria() : dict
    - _precedencia(token) : int
  }
  class JavaLexer
  class JavaParser {
    + analizar() : list
    + sentencia() : dict
    - _clase() : dict
    - _miembro() : dict
    - _funcion_o_declaracion() : dict
    - _declaracion_toplevel() : dict
    - _declaracion_import() : dict
    - _declaracion_package() : dict
    - _opt_extends() : str
  }
  class JavaScriptLexer
  class JavaScriptParser {
    + sentencia() : dict
    - _declaracion_js() : dict
    - _funcion_js() : dict
    - _asignacion_js() : dict
    - _expresion_o_flecha() : dict
    - _funcion_flecha_con_parentesis() : dict
    - _funcion_flecha_simple() : dict
    - _id_primaria(token) : dict
  }
  class PythonLexer {
    - _procesar_indentacion(line, n)
    - _crear_token(tipo, texto, linea, col)
  }
  class PythonParser {
    + analizar() : list
    + sentencia() : dict
    + funcion() : dict
    - _clase() : dict
    + sentencia_if() : dict
    + sentencia_while() : dict
    + sentencia_for() : dict
    + bloque() : list
    + expresion() : dict
    - _sentencia_import() : dict
    - _sentencia_from() : dict
    - _primaria() : dict
  }
}

package "core.semantica" <<POLIMORFISMO>> {
  abstract class ValidadorSemanticoBase {
    # ast : list
    # errores : list
    # advertencias : list
    # ambitos : list[dict]
    + validar() : dict
    - _push_ambito()
    - _pop_ambito()
    - _declarar(nombre, linea)
    - _existe(nombre) : bool
    # _validar_nodo(nodo)
    # _validar_declaracion(nodo)
    # _validar_asignacion(nodo)
    # _validar_funcion(nodo)
    # _validar_binaria(nodo)
    # _validar_if(nodo)
    # _validar_while(nodo)
    # _validar_for(nodo)
  }
  class ValidadorSemanticoC {
    + _validar_declaracion(nodo)
  }
  class ValidadorSemanticoCpp {
    + _validar_declaracion(nodo)
    + _validar_clase(nodo)
    + _validar_etiqueta_acceso(nodo)
  }
  class ValidadorSemanticoJava {
    + _validar_declaracion(nodo)
    + _validar_campo(nodo)
    + _validar_clase(nodo)
    + _validar_metodo(nodo)
  }
  class ValidadorSemanticoJS {
    + _validar_declaracion(nodo)
    + _validar_funcion_flecha(nodo)
  }
  class ValidadorSemanticoPython {
    + _validar_asignacion(nodo)
    + _validar_for(nodo)
  }
}

package "core" {
  class CalculadorEntropia {
    - tokens : list
    - frecuencias : Counter
    - total : int
    + calcular() : float
    + normalizacion() : float
    + densidad() : float
    + estadisticas_completas() : dict
  }
}

package "services" <<ENCAPSULAMIENTO>> {
  class ServicioAnalisis {
    + {static} analizar_codigo(codigo, lenguaje) : dict
    + {static} obtener_idiomas() : dict
  }
}

package "core.analizador_factory" <<FACTORY>> {
  class Factory <<singleton>> {
    - _ANALIZADORES : dict
    - _VALIDADORES : dict
    + get_analizador(lenguaje) : AnalizadorLenguaje
    + get_validador_semantico(lenguaje, ast) : ValidadorSemanticoBase
    + idiomas_disponibles() : dict
  }
}

' ============================================================
' HERENCIA (herencia)
' ============================================================

TokenBase <|-- Token

AnalizadorLexicoBase <|-- CLikeLexerBase
AnalizadorLexicoBase <|-- PythonLexer

ParserBase <|-- CLikeParserBase
ParserBase <|-- PythonParser

CLikeLexerBase <|-- CLexer
CLikeLexerBase <|-- CppLexer
CLikeLexerBase <|-- JavaLexer
CLikeLexerBase <|-- JavaScriptLexer

CLikeParserBase <|-- CParser
CLikeParserBase <|-- CppParser
CLikeParserBase <|-- JavaParser
CLikeParserBase <|-- JavaScriptParser

ValidadorSemanticoBase <|-- ValidadorSemanticoC
ValidadorSemanticoBase <|-- ValidadorSemanticoCpp
ValidadorSemanticoBase <|-- ValidadorSemanticoJava
ValidadorSemanticoBase <|-- ValidadorSemanticoJS
ValidadorSemanticoBase <|-- ValidadorSemanticoPython

' ============================================================
' COMPOSICION / ASOCIACION
' ============================================================

AnalizadorLenguaje --> AnalizadorLexicoBase : <<usa>>
AnalizadorLenguaje --> ParserBase : <<usa>>
AnalizadorLenguaje *-- "lexer_cls\nparser_cls" : composición

CAnalizadorLenguaje --|> AnalizadorLenguaje
CppAnalizadorLenguaje --|> AnalizadorLenguaje
JavaAnalizadorLenguaje --|> AnalizadorLenguaje
JavaScriptAnalizadorLenguaje --|> AnalizadorLenguaje
PythonAnalizadorLenguaje --|> AnalizadorLenguaje

ServicioAnalisis --> Factory : <<usa>>
ServicioAnalisis --> CalculadorEntropia : <<usa>>
Factory --> AnalizadorLenguaje : <<crea>>
Factory --> ValidadorSemanticoBase : <<crea>>
AnalizadorLenguaje --> Token : <<produce>>

' ============================================================
' LEYENDA
' ============================================================

note top of TokenBase
  <b>ABSTRACCIÓN</b>
  Clase base que define QUÉ hace
  un token, no CÓMO se implementa.
end note

note top of AnalizadorLexicoBase
  <b>ABSTRACCIÓN</b>
  Interfaz común para todos los
  analizadores léxicos.
end note

note right of CLikeLexerBase
  <b>HERENCIA</b>
  Comparte lógica común de regex
  para C, C++, Java, JavaScript.
end note

note bottom of CParser
  <b>POLIMORFISMO</b>
  sentencia() se comporta distinto
  en cada parser según el lenguaje.
end note

note right of ValidadorSemanticoBase
  <b>POLIMORFISMO</b>
  Cada lenguaje tiene reglas
  semánticas propias.
end note

note bottom of ServicioAnalisis
  <b>ENCAPSULAMIENTO</b>
  Oculta la complejidad del análisis.
  Las rutas HTTP solo llaman al servicio.
end note

@enduml
